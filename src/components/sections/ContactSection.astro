---
import { business } from "../../data/business";
---

<section id="contact" class="section contact">
  <div class="container contact__grid">
    <div>
      <p class="eyebrow">Contact</p>
      <h2>Ready to make the backyard less “Vegas frying pan”?</h2>
      <p>
        Call or email Paradise Builders Las Vegas to discuss patio covers,
        pavers, concrete, outdoor lighting, landscaping, or outdoor living
        upgrades.
      </p>
    </div>

    <div class="contact-card card">
      <h3>{business.name}</h3>
      <p>
        <a href={`tel:${business.phone.replaceAll("-", "")}`}>{business.phone}</a><br />
        <a href={`mailto:${business.email}`}>{business.email}</a>
      </p>
      <p>
        {business.address.street}<br />
        {business.address.city}, {business.address.state} {business.address.zip}
      </p>
    </div>
  </div>
</section>

<style>
  .contact {
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  .contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(280px, 0.7fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .contact h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.5rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .contact p {
    color: var(--color-muted);
  }

  .contact-card {
    padding: 1.5rem;
  }

  .contact-card h3 {
    margin-top: 0;
  }

  .contact-card p {
    color: var(--color-muted);
  }

  @media (max-width: 900px) {
    .contact__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
