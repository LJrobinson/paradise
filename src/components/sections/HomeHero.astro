---
import { business } from "../../data/business";
---

<section class="hero section">
  <div class="container hero__grid">
    <div class="hero__content">
      <p class="eyebrow">Las Vegas outdoor living contractor</p>
      <h1>Outdoor spaces built for desert heat, real homes, and long-term trust.</h1>
      <p class="hero__lede">
        {business.name} designs and builds patio covers, pavers, concrete,
        lighting, landscaping, and backyard upgrades across Southern Nevada.
      </p>

      <div class="hero__actions">
        <a class="btn" href={`tel:${business.phone.replaceAll("-", "")}`}>
          Call {business.phone}
        </a>
        <a class="btn secondary" href="#services">View Services</a>
      </div>

      <div class="hero__proof" aria-label="Trust highlights">
        <span>Est. {business.establishedYear}</span>
        <span>Licensed</span>
        <span>Bonded</span>
        <span>Insured</span>
      </div>
    </div>

    <aside class="hero__card card">
      <p class="eyebrow">Built different</p>
      <h2>Structural steel + concrete capability under one roof.</h2>
      <p>
        Paradise Builders brings C-14 steel reinforcing and C-5 concrete
        contractor licensing into outdoor living projects where strength,
        shade, and finish quality matter.
      </p>
    </aside>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(4rem, 9vw, 8rem);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(280px, 0.7fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .hero h1 {
    max-width: 13ch;
    margin: 0;
    font-size: clamp(3rem, 8vw, 6.5rem);
    line-height: 0.92;
    letter-spacing: -0.07em;
  }

  .hero__lede {
    max-width: 42rem;
    color: var(--color-muted);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .hero__proof {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .hero__proof span {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-muted);
    font-size: 0.9rem;
    font-weight: 800;
  }

  .hero__card {
    padding: clamp(1.5rem, 4vw, 2rem);
  }

  .hero__card h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.5rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .hero__card p {
    color: var(--color-muted);
  }

  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .hero h1 {
      font-size: clamp(3rem, 16vw, 4.5rem);
    }
  }
</style>
