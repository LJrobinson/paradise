---
import { business } from "../../data/business";
---

<section class="hero section">
  <div class="container hero__grid">
    <div class="hero__content">
      <p class="eyebrow">Las Vegas outdoor living contractor</p>
      <h1>Outdoor spaces built for desert heat, real homes, and long-term trust.</h1>
      <p class="hero__lede">
        {business.name} designs and builds patio covers, pavers, concrete,
        lighting, landscaping, and backyard upgrades across Southern Nevada.
      </p>

      <div class="hero__actions">
        <a class="btn" href={`tel:${business.phone.replaceAll("-", "")}`}>
          Call {business.phone}
        </a>
        <a class="btn secondary" href="#services">View Services</a>
      </div>

      <div class="hero__proof" aria-label="Trust highlights">
        <span>Est. {business.establishedYear}</span>
        <span>Licensed</span>
        <span>Bonded</span>
        <span>Insured</span>
      </div>
    </div>

    <aside class="hero__card card">
      <p class="eyebrow">Built different</p>
      <h2>Structural steel + concrete capability under one roof.</h2>
      <p>
        Paradise Builders brings C-14 steel reinforcing and C-5 concrete
        contractor licensing into outdoor living projects where strength,
        shade, and finish quality matter.
      </p>
    </aside>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(4.5rem, 9vw, 8.5rem);
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(300px, 0.82fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  .hero h1 {
    max-width: 14ch;
    margin: 0;
    font-size: clamp(3.3rem, 8vw, 6.75rem);
    line-height: 0.95;
    letter-spacing: 0;
  }

  .hero__lede {
    max-width: 42rem;
    color: var(--color-muted);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.25rem;
  }

  .hero__proof {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 2.25rem;
  }

  .hero__proof span {
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-surface) 88%, transparent);
    color: var(--color-muted);
    font-size: 0.9rem;
    font-weight: 900;
    box-shadow: 0 8px 20px color-mix(in srgb, var(--color-text) 5%, transparent);
  }

  .hero__card {
    position: relative;
    overflow: hidden;
    padding: clamp(1.5rem, 4vw, 2.25rem);
    border-top: 5px solid var(--color-accent);
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--color-accent-soft) 55%, transparent), transparent),
      color-mix(in srgb, var(--color-surface) 94%, transparent);
  }

  .hero__card h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.5rem);
    line-height: 1;
    letter-spacing: 0;
  }

  .hero__card p {
    color: var(--color-muted);
  }

  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .hero h1 {
      font-size: clamp(3.1rem, 15vw, 4.5rem);
    }
  }
</style>
