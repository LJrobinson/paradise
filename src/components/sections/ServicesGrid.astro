---
import { getServicePath, services } from "../../data/services";
import ImagePlaceholder from "../ui/ImagePlaceholder.astro";
---

<section id="services" class="section services">
  <div class="container">
    <div class="section-heading">
      <p class="eyebrow">Services</p>
      <h2>One contractor for the backyard pieces that usually get scattered.</h2>
      <p>
        Patio covers, pavers, concrete, lighting, landscaping, and outdoor
        living upgrades designed around Las Vegas homes.
      </p>
    </div>

    <div class="service-grid">
      {services.map((service) => (
        <article class="service-card card">
          <div class="service-card__media">
            {service.cardImage ? (
              <img
                src={service.cardImage}
                alt={`${service.title} service example`}
                width="640"
                height="420"
                loading="lazy"
              />
            ) : (
              <ImagePlaceholder label={`${service.title} image coming soon`} aspectRatio="16 / 10" />
            )}
          </div>
          <div>
            <h3>{service.title}</h3>
            <p>{service.shortDescription}</p>
          </div>
          <a href={getServicePath(service.slug)}>Learn more →</a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .section-heading {
    max-width: 760px;
    margin-bottom: 2rem;
  }

  .section-heading h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.5rem);
    line-height: 1;
    letter-spacing: 0;
  }

  .section-heading p {
    color: var(--color-muted);
  }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.1rem;
  }

  .service-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    border-top: 4px solid color-mix(in srgb, var(--color-brand) 72%, var(--color-border));
  }

  .service-card__media {
    border-bottom: 1px solid var(--color-border);
  }

  .service-card__media img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .service-card > div:not(.service-card__media),
  .service-card > a {
    margin-inline: 1.5rem;
  }

  .service-card h3 {
    margin: 0;
    font-size: 1.35rem;
    line-height: 1.15;
  }

  .service-card p {
    color: var(--color-muted);
  }

  .service-card a {
    margin-bottom: 1.5rem;
    color: var(--color-brand-strong);
    font-weight: 900;
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .service-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .service-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
