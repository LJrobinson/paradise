---
import { business } from "../../data/business";
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div>
      <p class="eyebrow">Paradise Builders Las Vegas</p>
      <h2>Outdoor living built for Las Vegas.</h2>
      <p>{business.description}</p>
    </div>

    <div>
      <h3>Contact</h3>
      <p>
        <a href={`tel:${business.phone.replaceAll("-", "")}`}>{business.phone}</a><br />
        <a href={`mailto:${business.email}`}>{business.email}</a>
      </p>
      <p>
        {business.address.street}<br />
        {business.address.city}, {business.address.state} {business.address.zip}
      </p>
    </div>

    <div>
      <h3>Licenses</h3>
      <ul>
        {business.licenses.map((license) => (
          <li>
            #{license.number} · {license.classification} · {license.label}
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: clamp(3rem, 6vw, 4.75rem);
    border-top: 1px solid var(--color-border);
    background:
      linear-gradient(180deg, var(--color-surface-soft), color-mix(in srgb, var(--color-surface-soft) 72%, var(--color-bg))),
      var(--color-surface-soft);
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .site-footer h2,
  .site-footer h3,
  .site-footer p {
    margin-top: 0;
  }

  .site-footer ul {
    margin-bottom: 0;
    padding-left: 1.1rem;
  }

  .site-footer h2 {
    max-width: 12ch;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1;
  }

  .site-footer h3 {
    color: var(--color-brand-strong);
  }

  .site-footer a {
    font-weight: 800;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }

  @media (max-width: 820px) {
    .site-footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
