---
import { business } from "../../data/business";
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div>
      <p class="eyebrow">Paradise Builders Las Vegas</p>
      <h2>Outdoor living built for Las Vegas.</h2>
      <p>{business.description}</p>
    </div>

    <div>
      <h3>Contact</h3>
      <p>
        <a href={`tel:${business.phone.replaceAll("-", "")}`}>{business.phone}</a><br />
        <a href={`mailto:${business.email}`}>{business.email}</a>
      </p>
      <p>
        {business.address.street}<br />
        {business.address.city}, {business.address.state} {business.address.zip}
      </p>
    </div>

    <div>
      <h3>Licenses</h3>
      <ul>
        {business.licenses.map((license) => (
          <li>
            #{license.number} · {license.classification} · {license.label}
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: 4rem;
    border-top: 1px solid var(--color-border);
    background: var(--color-surface-soft);
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 2rem;
  }

  .site-footer h2,
  .site-footer h3,
  .site-footer p {
    margin-top: 0;
  }

  .site-footer ul {
    padding-left: 1.1rem;
  }

  @media (max-width: 820px) {
    .site-footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
