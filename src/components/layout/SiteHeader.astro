---
import { business } from "../../data/business";
import ThemeToggle from "../ui/ThemeToggle.astro";
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label={`${business.name} home`}>
      <span class="brand__mark">PB</span>
      <span>
        <strong>{business.shortName}</strong>
        <small>Las Vegas</small>
      </span>
    </a>

    <nav class="nav" aria-label="Main navigation">
      <a href="/#services">Services</a>
      <a href="/#projects">Projects</a>
      <a href="/#trust">Why Us</a>
      <a href="/#contact">Contact</a>
    </nav>

    <div class="header-actions">
      <ThemeToggle />
      <a class="phone-link" href={`tel:${business.phone.replaceAll("-", "")}`}>
        {business.phone}
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
    backdrop-filter: blur(16px);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.75rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }

  .brand__mark {
    display: grid;
    width: 2.9rem;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--color-brand) 75%, #fff);
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, var(--color-brand), var(--color-brand-strong));
    color: var(--color-brand-contrast);
    font-weight: 900;
    box-shadow: 0 10px 24px color-mix(in srgb, var(--color-brand) 24%, transparent);
  }

  .brand strong,
  .brand small {
    display: block;
    line-height: 1.1;
  }

  .brand small {
    color: var(--color-muted);
    font-size: 0.82rem;
    font-weight: 800;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--color-muted);
    font-size: 0.92rem;
    font-weight: 800;
  }

  .nav a {
    padding: 0.55rem 0.75rem;
    border-radius: 999px;
    text-decoration: none;
  }

  .nav a:hover {
    background: color-mix(in srgb, var(--color-surface) 72%, transparent);
    color: var(--color-text);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .phone-link {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding-inline: 1.1rem;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--color-accent), color-mix(in srgb, var(--color-accent) 82%, #000));
    color: var(--color-accent-contrast);
    font-weight: 900;
    text-decoration: none;
    box-shadow: 0 12px 26px color-mix(in srgb, var(--color-accent) 24%, transparent);
  }

  @media (max-width: 820px) {
    .site-header__inner {
      flex-wrap: wrap;
      padding-block: 0.75rem;
    }

    .nav {
      order: 3;
      width: 100%;
      justify-content: flex-start;
      gap: 0.35rem;
      overflow-x: auto;
      padding-bottom: 0.15rem;
      scrollbar-width: none;
      white-space: nowrap;
    }

    .nav::-webkit-scrollbar {
      display: none;
    }

    .phone-link {
      display: none;
    }
  }
</style>
