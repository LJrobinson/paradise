---
type Props = {
  label: string;
  aspectRatio?: string;
  class?: string;
};

const {
  label,
  aspectRatio = "4 / 3",
  class: className,
} = Astro.props;
---

<div
  class:list={["image-placeholder", className]}
  role="img"
  aria-label={label}
  style={`--image-placeholder-aspect-ratio: ${aspectRatio};`}
>
  <span>{label}</span>
</div>

<style>
  .image-placeholder {
    position: relative;
    display: grid;
    min-height: 100%;
    aspect-ratio: var(--image-placeholder-aspect-ratio);
    place-items: center;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--color-accent-soft) 78%, transparent), transparent),
      linear-gradient(45deg, color-mix(in srgb, var(--color-brand) 12%, transparent), transparent 62%),
      var(--color-surface-soft);
    color: var(--color-muted);
    font-weight: 900;
    text-align: center;
  }

  .image-placeholder::before {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(color-mix(in srgb, var(--color-border) 50%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--color-border) 50%, transparent) 1px, transparent 1px);
    background-size: 28px 28px;
    content: "";
    opacity: 0.35;
  }

  .image-placeholder span {
    position: relative;
    max-width: 16rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-surface) 88%, transparent);
    box-shadow: 0 10px 24px color-mix(in srgb, var(--color-text) 8%, transparent);
  }
</style>
