---
import BaseLayout from "../layouts/BaseLayout.astro";
import { business } from "../data/business";
---

<BaseLayout
  title="Page Not Found"
  description="The page you were looking for could not be found. Return to Paradise Builders Las Vegas or explore outdoor living services."
  canonicalPath="/404/"
  noindex={true}
>
  <section class="not-found section">
    <div class="container not-found__grid">
      <div>
        <p class="eyebrow">404</p>
        <h1>That page could not be found.</h1>
        <p class="not-found__lede">
          The page may have moved, or the link may be outdated. You can head
          back home, review Paradise Builders services, or call us directly.
        </p>

        <div class="not-found__actions">
          <a class="btn" href="/">Back to Home</a>
          <a class="btn secondary" href="/#services">View Services</a>
          <a class="btn secondary" href={`tel:${business.phone.replaceAll("-", "")}`}>
            Call {business.phone}
          </a>
        </div>
      </div>

      <aside class="not-found__card card">
        <p class="eyebrow">Paradise Builders Las Vegas</p>
        <h2>{business.tagline}</h2>
        <p>{business.description}</p>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-block: clamp(4.5rem, 10vw, 8rem);
  }

  .not-found__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.75fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .not-found h1 {
    max-width: 11ch;
    margin: 0;
    font-size: clamp(3.3rem, 8vw, 6.75rem);
    line-height: 0.95;
    letter-spacing: 0;
  }

  .not-found__lede {
    max-width: 44rem;
    color: var(--color-muted);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .not-found__card {
    padding: clamp(1.5rem, 4vw, 2rem);
    border-top: 5px solid var(--color-accent);
  }

  .not-found__card h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.5rem);
    line-height: 1;
  }

  .not-found__card p {
    color: var(--color-muted);
  }

  @media (max-width: 900px) {
    .not-found__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .not-found h1 {
      font-size: clamp(3.1rem, 15vw, 4.5rem);
    }
  }
</style>
