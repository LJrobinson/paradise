---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BreadcrumbJsonLd from "../../components/seo/BreadcrumbJsonLd.astro";
import { getProjectPath, projects } from "../../data/projects";
---

<BaseLayout
  title="Projects"
  description="Explore Paradise Builders Las Vegas project stories and outdoor living case studies across Southern Nevada."
  canonicalPath="/projects/"
>
  <BreadcrumbJsonLd
    items={[
      { name: "Home", path: "/" },
      { name: "Projects", path: "/projects/" },
    ]}
  />

  <section class="projects-hero section">
    <div class="container projects-hero__inner">
      <p class="eyebrow">Projects</p>
      <h1>Outdoor living project stories from Las Vegas homes.</h1>
      <p>
        Case studies help homeowners see how Paradise Builders approaches
        shade, surfaces, structure, and outdoor living details in real projects.
      </p>
    </div>
  </section>

  <section class="section project-listing">
    <div class="container project-grid">
      {projects.map((project) => (
        <article class="project-card card">
          <div class="project-media" aria-hidden="true">
            {project.heroImage ? (
              <img src={project.heroImage} alt="" loading="lazy" />
            ) : (
              <span>Project photos coming soon</span>
            )}
          </div>

          <div class="project-card__content">
            <p class="eyebrow">{project.projectType}</p>
            <h2>{project.title}</h2>
            <p>{project.summary}</p>
            <div class="project-meta">
              <span>{project.location}</span>
              <span>{project.services.join(" + ")}</span>
            </div>
            <a href={getProjectPath(project.slug)}>View project →</a>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .projects-hero {
    padding-top: clamp(4rem, 9vw, 8rem);
  }

  .projects-hero__inner {
    max-width: 820px;
  }

  .projects-hero h1 {
    margin: 0;
    font-size: clamp(3rem, 8vw, 6.5rem);
    line-height: 0.92;
    letter-spacing: -0.07em;
  }

  .projects-hero p,
  .project-card p,
  .project-meta {
    color: var(--color-muted);
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 1rem;
  }

  .project-card {
    overflow: hidden;
  }

  .project-media {
    display: grid;
    min-height: 220px;
    place-items: center;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface-soft);
    color: var(--color-muted);
    font-weight: 800;
    text-align: center;
  }

  .project-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-card__content {
    padding: 1.5rem;
  }

  .project-card h2 {
    margin: 0;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .project-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 1.25rem;
  }

  .project-meta span {
    padding: 0.4rem 0.65rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    font-size: 0.85rem;
    font-weight: 800;
  }

  .project-card a {
    color: var(--color-brand-strong);
    font-weight: 900;
    text-decoration: none;
  }

  @media (max-width: 760px) {
    .project-grid {
      grid-template-columns: 1fr;
    }

    .projects-hero h1 {
      font-size: clamp(3rem, 16vw, 4.5rem);
    }
  }
</style>
